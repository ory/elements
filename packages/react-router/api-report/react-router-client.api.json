          "canonicalReference": "@ory/react-router!getLoginFlow:function(1)",
          "docComment": "/**\n * Fetches the login flow for a React Router `loader`. Without a `flow` query parameter, or when the flow expired, it throws a redirect that starts a new flow.\n *\n * @param request - The `request` passed to the loader.\n *\n * @param config - The Ory configuration object.\n *\n * @example\n * ```tsx\n * import { Login } from \"@ory/elements-react/theme\"\n * import { getLoginFlow } from \"@ory/react-router\"\n * import type { Route } from \"./+types/login\"\n * import config from \"../ory.config\"\n *\n * export async function loader({ request }: Route.LoaderArgs) {\n *   return { flow: await getLoginFlow(request, config) }\n * }\n *\n * export default function LoginPage({ loaderData }: Route.ComponentProps) {\n *   return <Login flow={loaderData.flow} config={config} />\n * }\n * ```\n *\n * @public\n */\n",
