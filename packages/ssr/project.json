{
  "name": "@ory/ssr",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/ssr/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "command": "tsdown --config-loader tsx",
      "options": {
        "cwd": "packages/ssr"
      }
    },
    "dev": {
      "command": "tsdown --config-loader tsx --watch",
      "options": {
        "cwd": "packages/ssr"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "dependsOn": ["build"],
      "options": {
        "jestConfig": "packages/ssr/jest.config.ts",
        "coverage": true,
        "coverageReporters": ["text", "cobertura"]
      }
    },
    "api-extractor": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/ssr",
        "commands": ["api-extractor run --verbose -c config/api-extractor.json"]
      },
      "dependsOn": ["build"]
    },
    "api-extractor-refresh": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/ssr",
        "commands": [
          "api-extractor run --local --verbose -c config/api-extractor.json"
        ]
      },
      "dependsOn": ["build"]
    }
  }
}
